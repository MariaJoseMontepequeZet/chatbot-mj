# Copia este archivo a ".env" y completa los valores. El archivo .env NO se sube a Git.

# Clave de OpenAI (solo vive en el servidor; los navegadores nunca la ven).
OPENAI_API_KEY=

# Puerto del servidor.
PORT=3000

# Primer administrador (solo se usa la primera vez que arranca con la base vacía).
# Si dejas ADMIN_PASSWORD vacío, se genera una al azar y se muestra en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Ruta de la base de datos SQLite.
DB_PATH=./data/app.db

# Pon 1 cuando el sitio se sirva por HTTPS (cookie de sesión "Secure").
COOKIE_SECURE=0

# Zona horaria para la fecha que ve el agente ("hoy es …").
APP_TIMEZONE=America/Bogota

# Límite general de mensajes por día para cada Camper (el administrador puede cambiarlo en la app).
DEFAULT_DAILY_LIMIT=40

# Minutos sin actividad antes de cerrar la sesión, y duración máxima de una sesión en horas.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
